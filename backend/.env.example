# Copy to .env and adjust. All values can also be real environment variables.
DATABASE_URL=postgresql+psycopg://leilao:leilao@localhost:5432/leilao
# Generate each with: python -c "import secrets; print(secrets.token_hex(32))"  (use DIFFERENT values)
SECRET_KEY=change-me-to-a-long-random-string-0000000000
AUDIT_SECRET=change-me-to-another-long-random-string-00
SEED_ON_START=true
# Path of the built React app (frontend/dist). Leave empty while developing the front with `npm run dev`.
FRONTEND_DIST=
CORS_ORIGINS=http://localhost:5173
